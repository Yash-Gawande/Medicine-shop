# Copy to .env for local development. Full reference: docs/environment.md
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql+asyncpg://pharmacy:pharmacy@localhost:5433/pharmacy
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BUCKET=pharmacy-public-assets
S3_PRIVATE_BUCKET=pharmacy-private-documents

EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_BACKEND=console

CUSTOMER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
BUSINESS_STATE_CODE=27
